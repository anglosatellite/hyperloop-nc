{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "hyperloopNC": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "fr-FR",
        "locales": {
          "en": {
            "translation": "src/locale/messages.en.xlf",
            "baseHref": ""
          },
          "es": {
            "translation": "src/locale/messages.es.xlf",
            "baseHref": ""
          },
          "ko": {
            "translation": "src/locale/messages.ko.xlf",
            "baseHref": ""
          },
          "ja": {
            "translation": "src/locale/messages.ja.xlf",
            "baseHref": ""
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "en": {
              "localize": ["en"],
              "outputPath": "dist/site-en/",
              "i18nMissingTranslation": "error"
            },
            "es": {
              "localize": ["es"],
              "outputPath": "dist/site-es/",
              "i18nMissingTranslation": "error"
            },
            "ko": {
              "localize": ["ko"],
              "outputPath": "dist/site-ko/",
              "i18nMissingTranslation": "error"
            },
            "ja": {
              "localize": ["ja"],
              "outputPath": "dist/site-ja/",
              "i18nMissingTranslation": "error"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "en": {
              "buildTarget": "hyperloopNC:build:en"
            },
            "es": {
              "buildTarget": "hyperloopNC:build:es"
            },
            "ko": {
              "buildTarget": "hyperloopNC:build:ko"
            },
            "ja": {
              "buildTarget": "hyperloopNC:build:ja"
            },
            "production": {
              "buildTarget": "hyperloopNC:build:production"
            },
            "development": {
              "buildTarget": "hyperloopNC:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
